# ローカル用の環境変数テンプレート。実際の値を入れた .env はコミットしないこと。
# 本番(Render)ではダッシュボードの環境変数で設定する。

# Anthropic APIキー
ANTHROPIC_API_KEY=sk-ant-xxxxx

# CORSで許可するフロントのオリジン（カンマ区切り可）。末尾スラッシュは付けない。
# 例: https://yongouki.github.io  （独自ドメイン/別ホストなら実際の配信元に変える）
ALLOWED_ORIGINS=https://yongouki.github.io

# 1日の上限。0=無制限（門番無効・開発用）、1=1日1回。
DAILY_LIMIT=1
